# Copy to .env and fill in. .env is git-ignored; never commit real credentials.

# --- Server ---
PORT=3000
# 127.0.0.1 = this machine only; 0.0.0.0 = reachable on your network / when deployed
HOST=127.0.0.1
# production (template caching) or development
NODE_ENV=production
# Public address of the site (used in sitemap.xml / robots.txt), e.g. https://www.example.com
PUBLIC_URL=

# --- Email notifications via Titan Email (titan.email) ---
# Titan SMTP: smtp.titan.email, port 465 with SSL (SMTP_SECURE=true) or 587 with STARTTLS (SMTP_SECURE=false)
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_SECURE=true
# Full Titan mailbox address and its password
SMTP_USER=notifications@yourdomain.com
SMTP_PASS=
# Sender shown on emails (normally the same mailbox as SMTP_USER)
MAIL_FROM=notifications@yourdomain.com
# Where new sign-ups and applications are sent (comma-separate several addresses)
MAIL_TO=you@yourdomain.com
# Also email a confirmation to the person who submitted the form
MAIL_SEND_CONFIRMATIONS=true

# Form submissions are always appended here too (JSON lines)
SUBMISSIONS_FILE=storage/submissions.jsonl

# Max form submissions per minute per visitor IP (per form)
FORM_RATE_LIMIT=5

# --- Ordering ---
# Orders at or above this subtotal ship free (the site banner says $159.99)
FREE_SHIPPING_MIN=159.99
# Shipping charged below that amount
SHIPPING_FLAT_RATE=19.99
MAX_QTY_PER_ITEM=20
# Shown at checkout and in order emails (no card details are collected online)
PAYMENT_NOTE=No payment is taken online. Our customer care team will contact you within one business day to confirm your order and arrange payment.
# Orders are appended here (JSON lines); carts are persisted here
ORDERS_FILE=storage/orders.jsonl
CARTS_FILE=storage/carts.json
