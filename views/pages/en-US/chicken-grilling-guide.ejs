<div class="container">
		<div class="row mt-5 mb-5 bg-color-light-grey">
			<div class="col-sm-12 col-md-12 col-lg-6 my-auto p-0">
				<a href="/en-US/chicken/value-packs/"><img src="/images/content/grill-chicken-home-delivery.jpg" width="100%" alt="best meat delivery - Perdue Farms" /></a>
			</div>

		<div class="col-sm-12 col-md-12 col-lg-6 my-auto">
