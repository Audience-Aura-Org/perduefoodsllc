<div class="about-us">
	<section class="about-us-top">
		<div class="about-us-top-content container libre-caslon">
			<div class="row row-cols-1 row-cols-lg-2">
				<div class="col about-us-top-heading">
					<ul class="list-inline">
						<li class="font-italic">The</li>
						<li>Perdue Farms</li>
						<li class="font-italic">Story</li>
					</ul>
