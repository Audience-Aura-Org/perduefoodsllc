<%#
  Benefits strip. locals: variant ('overlap' | 'band'), cls
  'overlap' tucks under a hero; 'band' is the full-width strip above the footer.
%>
<% const _variant = locals.variant || 'overlap'; %>
<% const _list = `<ul class="pf-perks${_variant === 'overlap' ? ' pf-perks--overlap container' : ''}"${_variant === 'overlap' ? ' aria-label="Why shop with us"' : ''}>
  <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg><span><strong>Free shipping</strong> on orders over $159.99</span></li>
  <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11 12 4l9 7v9H3z"/><path d="M9 20v-6h6v6"/></svg><span><strong>Family farms</strong> raising food since 1920</span></li>
  <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3c4 3 6 6 6 9a6 6 0 0 1-12 0c0-3 2-6 6-9z"/><path d="M12 9v9"/></svg><span><strong>No antibiotics ever</strong> on our chicken</span></li>
  <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h11a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3z"/><path d="M5 17a3 3 0 0 1 3-3h11"/></svg><span><strong>260+ recipes</strong> for every night</span></li>
</ul>`; %>
<% if (_variant === 'band') { %>
<section class="pf-perks-band<%= locals.cls ? ' ' + locals.cls : '' %>" aria-label="Why shop with us"><%- _list %></section>
<% } else { %>
<%- _list %>
<% } %>
