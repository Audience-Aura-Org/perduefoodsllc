<%- include('/partials/document-start', { title }) %>
<%- include('/partials/header') %>
<div class="main-content" id="maincontent">
  <div class="container offline-page offline-notice">
    <h1 class="offline-title">Something went wrong</h1>
    <p>The page couldn’t be displayed. Please try again.</p>
    <% if (message) { %><pre class="offline-error"><%= message %></pre><% } %>
    <p class="offline-actions"><a class="btn btn-primary" href="/">Back to home</a></p>
  </div>
</div>
<%- include('/partials/footer') %>
<%- include('/partials/document-end') %>
